# Canonical audited runtime substrate is intentionally versionable.
!/third_party/runtimes/
!/third_party/runtimes/impeccable-static-html/
!/third_party/runtimes/impeccable-static-html/node_modules/
!/third_party/runtimes/impeccable-static-html/node_modules/**

# External checkouts remain independent and are reproduced from the lock manifest
vendor/
external/

# Repo-local FTK-owned adapter Skills are versioned under .agents/skills.
# External checkouts remain ignored under external/ and are never discovery roots.

