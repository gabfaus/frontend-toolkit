        },
        {
          "path": "styles.css",
          "type": "css",
          "content": ".card .copy { color: #111; background: #fff; } main#app.card > section[data-role=\"panel\"] > p.copy[data-kind=\"copy\"]:first-child { color: #fff !important; background: #fff; }"
