{
  "schemaVersion": 1,
  "capability": "browser-qa.playwright",
  "classification": "CORE",
  "cli": "@playwright/cli@0.1.19",
  "provider": "integrations/browser-qa/browser-session-provider.ps1",
  "providerContract": "browser-qa.transaction -> BrowserEvidenceBundle",
  "failureTaxonomy": [
    "INVALID_INPUT",
    "DEPENDENCY_OR_RUNTIME_FAILURE",
    "UPSTREAM_EXECUTION_FAILURE",
    "OUTPUT_CONTRACT_FAILURE",
    "TIMEOUT",
    "UNKNOWN_FAILURE"
  ],
  "executionStates": [
    "preflight",
    "childStarted",
    "browserReady",
    "sessionReady",
    "evidenceCaptured",
    "sessionClosed",
    "cleanup"
  ],
  "officialSkill": "playwright-cli",
  "defaults": {
    "headless": true,
    "isolated": true,
    "ephemeralBrowser": true,
    "temporaryDedicatedOutput": true,
    "syntheticFixturesOnly": true,
    "realProfile": false,
    "cdpAttach": false,
    "persistentAuthentication": false,
    "arbitraryJavaScript": false,
    "unrestrictedFilesystem": false,
    "automaticBrowserDownload": false,
    "automaticPackageInstallation": false,
    "externalTraffic": false
  },
  "allowedActions": [
    "session.open",
    "navigate",
    "viewport.resize",
    "capture.dom",
    "capture.ax",
    "capture.screenshot",
    "capture.requests",
    "interaction",
    "session.close",
    "open",
    "goto",
    "snapshot",
    "screenshot",
    "find",
    "click",
    "dblclick",
    "fill",
    "type",
    "press",
    "hover",
    "select",
    "check",
    "uncheck",
    "reload",
    "go-back",
    "go-forward",
    "resize",
    "tab-list",
    "tab-new",
    "tab-close",
    "tab-select",
    "dialog-accept",
    "dialog-dismiss",
    "console",
    "requests",
    "tracing-start",
    "tracing-stop",
    "recording-start",
    "recording-stop",
    "generate-locator",
    "close"
  ],
  "blockedActions": [
    "eval",
    "run-code",
    "attach",
    "state-save",
    "state-load",
    "cookie-list",
    "cookie-get",
    "cookie-set",
    "cookie-delete",
    "cookie-clear",
    "localstorage-list",
    "localstorage-get",
    "localstorage-set",
    "localstorage-delete",
    "localstorage-clear",
    "sessionstorage-list",
    "sessionstorage-get",
    "sessionstorage-set",
    "sessionstorage-delete",
    "sessionstorage-clear",
    "open --persistent",
    "open --profile",
    "install",
    "delete-data",
    "kill-all",
    "close-all",
    "upload",
    "drop"
  ],
  "urlPolicy": {
    "allowedOrigins": [
      "http://localhost",
      "http://127.0.0.1",
      "http://[::1]"
    ],
    "externalOriginDecision": "AUTHORIZATION_REQUIRED",
    "credentialsInUrl": "deny",
    "fileUrls": "deny-by-default"
  },
  "environmentAllowlist": [
    "SystemRoot",
    "ComSpec",
    "TEMP",
    "TMP",
    "FTK_BROWSER_QA_HOST_TEMP",
    "PLAYWRIGHT_BROWSERS_PATH",
    "PWTEST_DAEMON_SESSION_DIR",
    "PWTEST_SERVER_REGISTRY",
    "PWTEST_CLI_GLOBAL_CONFIG",
    "PLAYWRIGHT_MCP_SANDBOX",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "PLAYWRIGHT_HTML_OPEN",
    "NO_COLOR",
    "NO_UPDATE_NOTIFIER"
  ],
  "environmentValues": {
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
    "PLAYWRIGHT_HTML_OPEN": "never",
    "NO_COLOR": "1",
    "NO_UPDATE_NOTIFIER": "1"
  },
  "limits": {
    "transactionOperations": 64,
    "actionTimeoutMilliseconds": 30000,
    "defaultTimeoutMilliseconds": 120000,
    "maximumTimeoutMilliseconds": 600000,
    "stdoutCharacters": 262144,
    "stderrCharacters": 262144,
    "domNodes": 300,
    "axNodes": 300,
    "requestItems": 300,
    "screenshotArtifacts": 8,
    "screenshotBytes": 20971520
  },
  "headlessContract": {
    "required": true,
    "flag": "--no-headed",
    "verification": "provider output must report headless=true and headlessControl=explicit-cli-flag"
  },
  "outputBoundary": "%TEMP%/ftk-playwright/<session-id>",
  "pageScripts": "target-page execution only; no injected scripts",
  "networkBoundary": {
    "initialUrl": "loopback-only",
    "externalSubrequests": "deny-or-fail-closed",
    "interception": "not exposed by pinned CLI; capture.requests observes and fails closed on external origins",
    "redirects": "external redirect is a verification failure"
  },
  "browserIdentity": {
    "revisionPinTracked": true,
    "revision": "1243",
    "browserVersion": "153.0.8010.12",
    "status": "RUNTIME_DESCRIPTOR_AND_TEMP_INSTALLATION_VERIFIED",
    "limitation": "The browser executable hash is environment-specific and belongs in real evidence rather than the source tree."
  }
}
