{
  "schemaVersion": 1,
  "capability": "browser-qa.playwright",
  "classification": "CORE",
  "cli": "@playwright/cli@0.1.19",
  "officialSkill": "playwright-cli",
  "defaults": {
    "headless": true,
    "isolated": true,
    "ephemeralBrowser": true,
    "temporaryDedicatedOutput": true,
    "syntheticFixturesOnly": true,
    "realProfile": false,
    "cdpAttach": false,
    "persistentAuthentication": false,
    "arbitraryJavaScript": false,
    "unrestrictedFilesystem": false,
    "automaticBrowserDownload": false,
    "automaticPackageInstallation": false,
    "externalTraffic": false
  },
  "allowedActions": [
    "open",
    "goto",
    "snapshot",
    "screenshot",
    "find",
    "click",
    "dblclick",
    "fill",
    "type",
    "press",
    "hover",
    "select",
    "check",
    "uncheck",
    "reload",
    "go-back",
    "go-forward",
    "resize",
    "tab-list",
    "tab-new",
    "tab-close",
    "tab-select",
    "dialog-accept",
    "dialog-dismiss",
    "console",
    "requests",
    "tracing-start",
    "tracing-stop",
    "recording-start",
    "recording-stop",
    "generate-locator",
    "close"
  ],
  "blockedActions": [
    "eval",
    "run-code",
    "attach",
    "state-save",
    "state-load",
    "cookie-list",
    "cookie-get",
    "cookie-set",
    "cookie-delete",
    "cookie-clear",
    "localstorage-list",
    "localstorage-get",
    "localstorage-set",
    "localstorage-delete",
    "localstorage-clear",
    "sessionstorage-list",
    "sessionstorage-get",
    "sessionstorage-set",
    "sessionstorage-delete",
    "sessionstorage-clear",
    "open --persistent",
    "open --profile",
    "install",
    "delete-data",
    "kill-all",
    "close-all",
    "upload",
    "drop"
  ],
  "urlPolicy": {
    "allowedOrigins": [
      "http://localhost",
      "http://127.0.0.1",
      "http://[::1]"
    ],
    "externalOriginDecision": "AUTHORIZATION_REQUIRED",
    "credentialsInUrl": "deny",
    "fileUrls": "deny-by-default"
  },
  "environmentAllowlist": [
    "SystemRoot",
    "ComSpec",
    "TEMP",
    "TMP",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "PLAYWRIGHT_HTML_OPEN",
    "NO_COLOR",
    "NO_UPDATE_NOTIFIER"
  ],
  "environmentValues": {
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
    "PLAYWRIGHT_HTML_OPEN": "never",
    "NO_COLOR": "1",
    "NO_UPDATE_NOTIFIER": "1"
  },
  "outputBoundary": "%TEMP%/ftk-playwright/<session-id>",
  "pageScripts": "target-page execution only; no injected scripts",
  "networkBoundary": "loopback allowlist is defense-in-depth, not the sole security boundary"
}
