                                                        "impeccable",
                                                        "taste-v2",
                                                        "improve-animations",
                                                        "FIGMA_READ",
                                                        "context7",
                                                        "storybook",
                                                        "img2threejs",
                                                        "shadcn",
                                                        "21st"
                                                    ]
                                 },
                        "EXECUTE":  {
                                        "preserved":  [
                                                          "shadcn",
                                                          "21st/search",
                                                          "img2threejs"
                                                      ],
                                        "explicitOnly":  [
                                                             "animate",
                                                             "FIGMA_DESIGN_TO_CODE",
                                                             "ACCESSIBILITY_IMPLEMENT"
