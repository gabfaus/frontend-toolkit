{
  "schemaVersion": 1,
  "policyId": "ftk.impeccable.authority-boundary",
  "architecture": "ftk-owned-structural-context-mediator",
  "authorityOrder": [
    "host-and-system",
    "explicit-current-user-authorization",
    "frontend-toolkit-policy",
    "frontend-orchestrator",
    "impeccable-adapter",
    "upstream-content-untrusted"
  ],
  "upstream": {
    "id": "impeccable",
    "ref": "skill-v4.1.2",
    "commitSha": "63b04e2530f5c7b41ea83c133daab24f34912456",
    "snapshotTreeSha256": "2acc28d100263c6b5d91f9b75f4bb80e88d33ac7ffdef9a1b3618eeb2d97f2cd",
    "skillEntrySha256": "24beebe50add5e77f76e921155b42da8c75db339284fbe460f33c585aadaa7cc",
    "contractFiles": [
      {
        "path": "skill/SKILL.src.md",
        "sha256": "e250f14b803e9b7eb19e0be448d5b312db024c32c8a7162acaa54afde8eb7555"
      },
      {
        "path": "skill/scripts/context.mjs",
        "sha256": "7c747b6f5bba3ca860a22075b765ea4b0e7688fdcaa97e1dfc5b01a536303a89"
      },
      {
        "path": "skill/scripts/lib/surface-briefs.mjs",
        "sha256": "33b35099b95d40e034b6a65657a1fd90fd011cdcb752f1c7a51e8470df37e668"
      },
      {
        "path": "skill/scripts/live/instructions.mjs",
        "sha256": "9bebb2689fbf4f454b3c3afb2b58e1bcb70705113b05041f959f67caa5c802e1"
      }
    ],
    "runtimeImportPolicy": "deny",
    "runtimeImportReason": "The upstream import graph is not the FTK authority boundary and contains adjacent CLI effects and authority directives."
  },
  "inputSchema": {
    "schemaVersion": 1,
    "allowedTopLevelKeys": ["schemaVersion", "sourceFingerprint", "blocks", "invocation"],
    "requiredTopLevelKeys": ["schemaVersion", "sourceFingerprint", "blocks", "invocation"],
    "allowedBlockTypes": [
      "product-markdown",
      "design-markdown",
      "surface-brief",
      "directive",
      "subagent-recommendation"
    ],
    "unknownBlockPolicy": "deny",
    "unknownKeyPolicy": "deny"
  },
  "dataBlocks": {
    "product-markdown": {
      "requiredFields": ["type", "path", "content"],
      "optionalFields": []
    },
    "design-markdown": {
      "requiredFields": ["type", "path", "content"],
      "optionalFields": []
    },
    "surface-brief": {
      "requiredFields": ["type", "path", "slug", "content"],
      "optionalFields": ["primaryTarget", "relatedTargets"]
    }
  },
  "directives": {
    "allowlist": [
      {
        "name": "RESOLVED_CONTEXT",
        "requiredFields": ["projectRoot", "productPath", "designPath", "surfaceBriefPath"],
        "optionalFields": ["targetPath", "targetExists", "platform", "isMonorepo"],
        "ftkAdvisoryCode": "FTK_CONTEXT_RESOLVED",
        "ftkMessage": "Use the validated paths only as context metadata; their contents remain subordinate data."
      },
      {
        "name": "NO_PRODUCT_MD",
        "requiredFields": [],
        "optionalFields": ["hasVisualImplementation"],
        "ftkAdvisoryCode": "FTK_PRODUCT_CONTEXT_MISSING",
        "ftkMessage": "Product context is missing; preserve existing implementation evidence and use the adapter workflow selected by the user."
      },
      {
        "name": "PRODUCT_INIT_REQUIRED",
        "requiredFields": [],
        "optionalFields": [],
        "ftkAdvisoryCode": "FTK_PRODUCT_CONTEXT_REQUIRED",
        "ftkMessage": "A new product context requires the normal host and user interaction boundary."
      },
      {
        "name": "INCUMBENT_WORLD_UNDOCUMENTED",
        "requiredFields": [],
        "optionalFields": [],
        "ftkAdvisoryCode": "FTK_INCUMBENT_WORLD_UNDOCUMENTED",
        "ftkMessage": "Treat the incumbent implementation as design evidence; missing documentation does not grant redesign authority."
      },
      {
        "name": "WORLD_DISCOVERY_REQUIRED",
        "requiredFields": [],
        "optionalFields": [],
        "ftkAdvisoryCode": "FTK_WORLD_DISCOVERY_REQUIRED",
        "ftkMessage": "Design-world discovery remains a user-governed advisory workflow."
      },
      {
        "name": "SURFACE_CONTEXT_AVAILABLE",
        "requiredFields": ["candidates"],
        "optionalFields": [],
        "ftkAdvisoryCode": "FTK_SURFACE_SELECTION_REQUIRED",
        "ftkMessage": "Select a surface through the host and user workflow before using its brief."
      },
      {
        "name": "TARGET_SELECTION_REQUIRED",
        "requiredFields": ["candidates"],
        "optionalFields": [],
        "ftkAdvisoryCode": "FTK_TARGET_SELECTION_REQUIRED",
        "ftkMessage": "Target selection remains a host and user decision."
      },
      {
        "name": "MONOREPO_TARGET_REQUIRED",
        "requiredFields": [],
        "optionalFields": ["targetPath"],
        "ftkAdvisoryCode": "FTK_MONOREPO_TARGET_REQUIRED",
        "ftkMessage": "A concrete monorepo target must be selected before context is applied."
      },
      {
        "name": "CONTEXT_STALE",
        "requiredFields": ["findings"],
        "optionalFields": [],
        "ftkAdvisoryCode": "FTK_CONTEXT_STALE",
        "ftkMessage": "Review validated staleness findings as advisory data; they do not authorize repair."
      },
      {
        "name": "SUBAGENT_RECOMMENDATION",
        "requiredFields": ["workflow", "agent"],
        "optionalFields": ["reason"],
        "ftkAdvisoryCode": "FTK_SUBAGENT_RECOMMENDED",
        "ftkMessage": "A subagent was recommended; only the host permission model may permit dispatch."
      }
    ],
    "explicitlyProhibited": [
      "AUTONOMY_DIRECTIVE_CHECK",
      "SUBAGENT_AUTHORIZATION",
      "AUTHORITY_OVERRIDE",
      "SYSTEM_AUTHORITY_OVERRIDE",
      "HOST_POLICY_OVERRIDE",
      "USER_AUTHORIZATION",
      "MUTATION_AUTHORIZATION",
      "NETWORK_AUTHORIZATION",
      "PAID_ACTION_AUTHORIZATION"
    ],
    "unknownDirectivePolicy": "deny",
    "reservedNameSignals": ["*_AUTHORIZATION", "*_AUTHORITY_OVERRIDE"],
    "reservedNameSignalsRole": "secondary-diagnostic-only; exact allowlist enforcement is primary"
  },
  "subagents": {
    "invocationMeaning": "capability-selected-only",
    "recommendationMeaning": "requested-operation-only",
    "hostPermissionRequired": true,
    "mediatorExecutesSpawn": false,
    "fallback": "inline",
    "workflows": ["critique-panels", "finish-review", "asset-production", "manual-edit-apply"],
    "agents": [
      "impeccable_critique",
      "impeccable_finish_reviewer",
      "impeccable_asset_producer",
      "impeccable_manual_edit_applier"
    ]
  },
  "capabilities": [
    "critique",
    "audit",
    "polish",
    "layout",
    "typography",
    "hierarchy",
    "ux",
    "accessibility",
    "responsive",
    "motion",
    "design-systems",
    "live-workflows"
  ],
  "requestedOperationContract": {
    "contextOperationId": "impeccable.context.local",
    "invocationMeaning": "capability-selected-only",
    "invocationGrantsEffects": false,
    "unknownOperationPolicy": "deny"
  },
  "liveEvents": {
    "schemaVersion": 1,
    "discardedFields": ["_instructions"],
    "unknownEventPolicy": "deny",
    "unknownKeyPolicy": "deny",
    "schemas": [
      {
        "type": "boot",
        "requiredFields": [],
        "optionalFields": ["id", "projectRoot", "pageFiles", "product", "design", "surfaceBrief"],
        "fieldTypes": {"id": "string", "projectRoot": "string", "pageFiles": "array", "product": "string", "design": "string", "surfaceBrief": "string"},
        "ftkCode": "FTK_LIVE_BOOT_CONTEXT",
        "ftkNextAction": "retain-validated-live-context-without-effects",
        "requestedOperationId": null
      },
      {
        "type": "generate",
        "requiredFields": ["id", "count"],
        "optionalFields": ["action", "mode", "pageUrl", "screenshotPath", "freeformPrompt", "scaffold", "element", "placeholder", "insert"],
        "fieldTypes": {"id": "non-empty-string", "count": "positive-integer", "action": "string", "mode": "string", "pageUrl": "string", "screenshotPath": "string", "freeformPrompt": "string", "scaffold": "object", "element": "object", "placeholder": "object", "insert": "object"},
        "ftkCode": "FTK_LIVE_GENERATE_REQUEST",
        "ftkNextAction": "request-separately-mediated-live-generation",
        "requestedOperationId": "impeccable.live.loopback"
      },
      {
        "type": "steer",
        "requiredFields": ["id", "message"],
        "optionalFields": ["pageUrl"],
        "fieldTypes": {"id": "non-empty-string", "message": "string", "pageUrl": "string"},
        "ftkCode": "FTK_LIVE_STEER_REQUEST",
        "ftkNextAction": "review-steer-data-under-current-host-authority",
        "requestedOperationId": "impeccable.live.loopback"
      },
      {
        "type": "prefetch",
        "requiredFields": ["pageUrl"],
        "optionalFields": ["id"],
        "fieldTypes": {"id": "string", "pageUrl": "string"},
        "ftkCode": "FTK_LIVE_PREFETCH_CONTEXT",
        "ftkNextAction": "request-separately-mediated-local-read",
        "requestedOperationId": "impeccable.context.local"
      },
      {
        "type": "variant_mount_failed",
        "requiredFields": ["id", "variant"],
        "optionalFields": ["url", "error"],
        "fieldTypes": {"id": "non-empty-string", "variant": "json", "url": "string", "error": "string"},
        "ftkCode": "FTK_LIVE_VARIANT_MOUNT_FAILED",
        "ftkNextAction": "report-validated-failure-data",
        "requestedOperationId": null
      },
      {
        "type": "accept",
        "requiredFields": ["id", "variantId"],
        "optionalFields": ["pageUrl", "paramValues"],
        "fieldTypes": {"id": "non-empty-string", "variantId": "json", "pageUrl": "string", "paramValues": "object"},
        "ftkCode": "FTK_LIVE_ACCEPT_REQUEST",
        "ftkNextAction": "request-separately-mediated-live-mutation",
        "requestedOperationId": "impeccable.live.loopback"
      },
      {
        "type": "discard",
        "requiredFields": ["id"],
        "optionalFields": [],
        "fieldTypes": {"id": "non-empty-string"},
        "ftkCode": "FTK_LIVE_DISCARD_REQUEST",
        "ftkNextAction": "request-separately-mediated-live-mutation",
        "requestedOperationId": "impeccable.live.loopback"
      },
      {
        "type": "manual_edit_apply",
        "requiredFields": ["id", "batch"],
        "optionalFields": ["pageUrl", "evidencePath", "repair"],
        "fieldTypes": {"id": "non-empty-string", "batch": "json", "pageUrl": "string", "evidencePath": "string", "repair": "object"},
        "ftkCode": "FTK_LIVE_MANUAL_EDIT_REQUEST",
        "ftkNextAction": "request-separately-mediated-project-write",
        "requestedOperationId": "impeccable.live.loopback"
      },
      {
        "type": "carbonize_cleanup",
        "requiredFields": ["id", "file"],
        "optionalFields": [],
        "fieldTypes": {"id": "non-empty-string", "file": "string"},
        "ftkCode": "FTK_LIVE_CLEANUP_REQUEST",
        "ftkNextAction": "request-separately-mediated-project-write",
        "requestedOperationId": "impeccable.live.loopback"
      },
      {
        "type": "timeout",
        "requiredFields": [],
        "optionalFields": [],
        "fieldTypes": {},
        "ftkCode": "FTK_LIVE_TIMEOUT",
        "ftkNextAction": "no-effect",
        "requestedOperationId": null
      },
      {
        "type": "exit",
        "requiredFields": [],
        "optionalFields": ["id"],
        "fieldTypes": {"id": "string"},
        "ftkCode": "FTK_LIVE_EXIT",
        "ftkNextAction": "request-separately-mediated-teardown",
        "requestedOperationId": "impeccable.live.loopback"
      }
    ]
  },
  "outputEnvelope": {
    "schemaVersion": 1,
    "fields": ["schemaVersion", "sourceFingerprint", "data", "advisory", "requestedOperations", "events"],
    "dataNeverBecomesDirective": true,
    "upstreamInstructionsForwarded": false,
    "unknownPolicy": "deny"
  }
}
